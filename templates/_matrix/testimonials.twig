{#
    Mnenja strank (Google ocene) — carousel
    data.rating, data.ratingSource, data.heading, data.headingHighlight
    data.reviews (array) -> { text, name, date }
#}
{% set data = data is defined ? data : field %}
{% set reviews = mnenjaStrank.mnenjeStranke.all() %}

<section class="testimonials-slider">
    <div class="container">
        <div class="section-head">
            <div class="rating-summary">
                <span class="stars">★★★★★</span>
                <span class="score">5,0</span>
                <span class="source">na podlagi Google ocen</span>
            </div>
            <h2>{{ data.heading ?? 'Kaj pravijo' }} <span>{{ data.headingHighlight ?? 'naše stranke' }}</span></h2>
        </div>

        <div class="swiper">
            <div class="swiper-wrapper">
                {% for review in reviews %}
                    <div class="swiper-slide">
                        <article class="review-card">
                            <div class="stars" aria-label="Ocena 5 od 5">★★★★★</div>
                            <p class="review-text">{{ review.mnenje }}</p>
                            <div class="review-author">
                                <div class="avatar" aria-hidden="true">{{ review.avtor | slice(0,1) }}</div>
                                <div class="meta">
                                    <div class="name">{{ review.avtor }}</div>
                                </div>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            </div>
            <div class="swiper-pagination"></div>
        </div>
    </div>
</section>
