{#
    O inštitutu — stran "O nas"
    Polja bloka (item): image, heading, description (Redactor)
    Postavitev: zgodba ob sliki (brez full-bleed hero).
#}
{% for item in field.about.all() %}
<div class="about-page">

    {# ───────────────────── DROBTINICE ───────────────────── #}
    <div class="breadcrumb-bar">
        <div class="container">
            <ul class="breadcrumb-list">
                <li><a href="/">{{ 'Domov' | t }}</a></li>
                <li class="sep">/</li>
                <li class="current">{{ 'O nas' | t }}</li>
            </ul>
        </div>
    </div>

    {# ───────────────────── ZGODBA + SLIKA ───────────────────── #}
    <section class="about-story">
        <div class="container">
            <div class="about-story__layout">
                <div class="about-story__copy">
                    {% if item.heading %}
                        <h1>{{ item.heading | nl2br }}</h1>
                    {% endif %}
                    {% if item.description %}
                        <div class="about-story__content">
                            {{ item.description | raw }}
                        </div>
                    {% endif %}
                </div>
                {% if item.image is defined and item.image.one() %}
                    <div class="about-story__media">
                        {% include "helpers/picture" with { desktop: { image: item.image.one(), width: 900 } } %}
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    {# ───────────────────── STATISTIKE ───────────────────── #}
    {% include "_matrix/statsBar" %}

    {# ───────────────────── ZAKAJ IZBRATI NAS ───────────────────── #}
    {% include "_matrix/valueProps" with {
        data: {
            eyebrow: 'Zakaj izbrati nas' | t,
            heading: 'Razlogi, da izberete' | t,
            headingHighlight: 'prav nas' | t,
            description: 'Vsak projekt izvedemo z enako mero natančnosti in skrbnosti — ne glede na velikost terase.' | t,
            props: [
                { icon: 'fal fa-sack-dollar', title: 'Najugodnejša cena na trgu' | t, description: 'Poštene cene naših storitev, lesa in ostalih materialov, brez skritih stroškov.' | t },
                { icon: 'fal fa-shield-check', title: 'Garancija do 10 let' | t, description: 'Za vse naše storitve prejmete ustrezne certifikate in garancijsko izjavo.' | t },
                { icon: 'fal fa-leaf', title: 'Originalni materiali' | t, description: 'Uporabljamo le preverjene materiale z ustreznimi certifikati kakovosti.' | t },
                { icon: 'fal fa-user-check', title: 'Oseben pristop' | t, description: 'Od prvega posveta do zadnjega vijaka smo v stalnem stiku z vami.' | t }
            ]
        }
    } %}

    {# ───────────────────── MEJNIKI ───────────────────── #}
    <section class="milestones">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">{{ 'Naša pot' | t }}</span>
                <h2>{{ 'Deset let' | t }} <span>{{ 'rasti in zaupanja' | t }}</span></h2>
            </div>
            <div class="milestones-grid">
                <div class="milestone-item">
                    <div class="milestone-year">2014</div>
                    <h3>{{ 'Ustanovitev inštituta' | t }}</h3>
                    <p>{{ 'Začeli smo z izdelavo lesenih konstrukcij in nizkoenergijsko gradnjo.' | t }}</p>
                </div>
                <div class="milestone-item">
                    <div class="milestone-year">2017</div>
                    <h3>{{ 'Prva terasa iz eksotičnega lesa' | t }}</h3>
                    <p>{{ 'Razširili smo ponudbo z izbranimi vrstami Cumaru, IPE Lapacho in Garapa.' | t }}</p>
                </div>
                <div class="milestone-item">
                    <div class="milestone-year">2020</div>
                    <h3>{{ '100. izvedena terasa' | t }}</h3>
                    <p>{{ 'Dosegli smo pomemben mejnik in okrepili ekipo izkušenih monterjev.' | t }}</p>
                </div>
                <div class="milestone-item">
                    <div class="milestone-year">2026</div>
                    <h3>{{ '500+ izvedenih teras' | t }}</h3>
                    <p>{{ 'Brez reklamacij in s povprečno oceno 5,0 na Googlu.' | t }}</p>
                </div>
            </div>
        </div>
    </section>

    {# ───────────────────── PRIZNANJA IN CERTIFIKATI ───────────────────── #}
    <section class="about-badges">
        <div class="container">
            <span class="badges-label">{{ 'Priznanja in certifikati' | t }}</span>
            <div class="badges-row">
                <img src="/assets/images/badges/ineg-badge-01.png" alt="" role="presentation" loading="lazy">
                <img src="/assets/images/badges/ineg-badge-02.jpg" alt="" role="presentation" loading="lazy">
                <img src="/assets/images/badges/ineg-badge-03.png" alt="" role="presentation" loading="lazy">
                <img src="/assets/images/badges/ineg-badge-04.png" alt="" role="presentation" loading="lazy">
            </div>
        </div>
    </section>

</div>

{# ───────────────────── STRUKTURIRANI PODATKI (SEO / AI) ───────────────────── #}
{% import "helpers/structured-data" as sd %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ entry.url | json_encode | raw }}
    },
    "name": {{ (item.heading ? item.heading | striptags : 'O nas') | json_encode | raw }},
    "description": {{ (item.description ? item.description | striptags : 'Že več kot desetletje izdelujemo lesene terase, fasade in ograje po meri.') | json_encode | raw }},
    "url": {{ entry.url | json_encode | raw }},
    "mainEntity": {
        "@type": "Organization",
        "name": "INeG – Inštitut nizkoenergijske gradnje",
        "url": "https://ineg.si",
        "foundingDate": "2014",
        "knowsAbout": ["Lesene terase", "Lesene fasade", "Lesene ograje", "Nizkoenergijska gradnja"],
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Ropretova cesta 18",
            "addressLocality": "Mengeš",
            "postalCode": "1234",
            "addressCountry": "SI"
        }
    }
}
</script>

{{ sd.breadcrumb([
    { name: 'Domov', url: siteUrl },
    { name: 'O nas', url: entry.url }
]) }}
{% endfor %}

{# ───────────────────── ZAKLJUČNI CTA ───────────────────── #}
{% include "_matrix/ctaBanner" with {
    data: {
        background: '/assets/images/lesene-terase-desktop2.jpg',
        eyebrow: 'Radi bi sodelovali' | t,
        heading: 'Spoznajmo se' | t,
        headingHighlight: 'osebno' | t,
        description: 'Kontaktirajte nas za brezplačen posvet in informativno ponudbo — z veseljem vam predstavimo, kako delamo.' | t,
        button: { url: '/kontakt', label: 'Kontaktirajte nas' | t },
        phone: { number: '+386 (0)40 567 518', label: 'Pokličite' | t, href: '+38640567518' }
    }
} %}
