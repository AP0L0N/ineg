{#
    Mreža storitev — lesene terase izpostavljene
    data.eyebrow, data.heading, data.headingHighlight, data.description
    data.services (array) -> { title, description, image, url, featured(bool), badge(string) }
#}
{% set data = data is defined ? data : field %}
{% set services = storitve.storitveInOpisi.active(true).all() %}

<section class="services-grid">
    <div class="container">
        <div class="section-head">
            {% if data.eyebrow is defined %}<span class="eyebrow">{{ data.eyebrow }}</span>{% endif %}
            <h2>{{ data.heading }}{% if data.headingHighlight is defined %} <span>{{ data.headingHighlight }}</span>{% endif %}</h2>
            {% if data.description is defined %}<p>{{ data.description }}</p>{% endif %}
        </div>

        <div class="services-layout">
            {% for service in services %}
                {% set storitev = service.povezanaStoritev.one() %}
                <a href="{{ storitev.url }}" class="service-card {{ loop.index == 1 ? 'is-featured' : '' }}">
                    <div class="card-bg" style="background-image: url({{ service.prikazneSlike.one().getUrl({ width: 800, format: 'jpg' }) }})"></div>
                    <div class="card-body">
                        {% if loop.index == 1 %}<span class="badge-primary">Naša specialnost</span>{% endif %}
                        <h3>{{ storitev.title }}</h3>
                        {% if service.kratekOpis is not empty %}<p>{{ service.kratekOpis }}</p>{% endif %}
                        <span class="arrow">Več o storitvi <i class="fal fa-angle-right"></i></span>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
