{#
    Poziv k akciji (CTA) banner
    data.background, data.eyebrow, data.heading, data.headingHighlight, data.description
    data.button ({ url, label })
    data.phone ({ number, label, href })
#}
{% set data = data is defined ? data : field %}

<section class="cta-banner"{% if data.background and data.background['volumeId'] is defined and data.background.one() %} style="background-image: url({{ data.background.one().getUrl({ width: 2500, format: 'jpg' }) }})"{% else %} style="background-image: url(/assets/images/lesene-terase-banner-2.jpg)" {% endif %}>
    <div class="container">
        <div class="cta-content">
            {% if data.eyebrow is defined %}<span class="eyebrow">{{ data.eyebrow }}</span>{% endif %}
            <h2>{{ data.heading }}{% if data.headingHighlight is defined %} <span>{{ data.headingHighlight }}</span>{% endif %}</h2>
            {% if data.description is defined %}<p>{{ data.description }}</p>{% endif %}

            <div class="cta-actions">
                <a href="/kontakt" class="btn btn-primary">Kontaktirajte nas</a>
                {% if contactInfo.contactInfo.telefon %}
                    <a href="tel:{{ contactInfo.contactInfo.telefon | replace({'(0)': '', ' ': ''}) }}" class="phone-link">
                        <span class="icon"><i class="fas fa-phone-alt"></i></span>
                        <span class="text">
                            <span class="label">{{ contactInfo.contactInfo.telefonIme }}</span>
                            <span class="number">{{ contactInfo.contactInfo.telefon }}</span>
                        </span>
                    </a>
                {% endif %}
                {% if contactInfo.contactInfo.telefon2 %}
                    <a href="tel:{{ contactInfo.contactInfo.telefon2 | replace({'(0)': '', ' ': ''}) }}" class="phone-link">
                        <span class="icon"><i class="fas fa-phone-alt"></i></span>
                        <span class="text">
                            <span class="label">{{ contactInfo.contactInfo.telefon2Ime }}</span>
                            <span class="number">{{ contactInfo.contactInfo.telefon2 }}</span>
                        </span>
                    </a>
                {% endif %}
                {% if not contactInfo.contactInfo.telefon and not contactInfo.contactInfo.telefon2 %}
                    <a href="tel:+38641661686" class="phone-link">
                        <span class="icon"><i class="fas fa-phone-alt"></i></span>
                        <span class="text">
                            <span class="label">{{ 'Robi' | t }}</span>
                            <span class="number">+386 (0)41 661 686</span>
                        </span>
                    </a>
                    <a href="tel:+38640567518" class="phone-link">
                        <span class="icon"><i class="fas fa-phone-alt"></i></span>
                        <span class="text">
                            <span class="label">{{ 'Žiga' | t }}</span>
                            <span class="number">+386 (0)40 567 518</span>
                        </span>
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</section>
