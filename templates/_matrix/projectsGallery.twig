{#
    Galerija projektov / referenc
    data.eyebrow, data.heading, data.headingHighlight, data.description
    data.button ({ url, label })
    data.projects (array) -> { image, category, title, size('wide'|'tall'|null) }
#}
{% set data = data is defined ? data : field %}
{% set projects = data.projects is defined and data.projects.all() | length > 0 ? data.projects.all() : craft.entries.section("projekti").orderBy("postDate desc").limit(6).all() %}

<section class="projects-gallery">
    <div class="container">
        <div class="section-head">
            <div class="head-text">
                {% if data.eyebrow is defined %}<span class="eyebrow">{{ data.eyebrow }}</span>{% endif %}
                <h2>{{ data.heading }}{% if data.headingHighlight is defined %} <span>{{ data.headingHighlight }}</span>{% endif %}</h2>
                {% if data.description is defined %}<p>{{ data.description }}</p>{% endif %}
            </div>
            {% set allProjects = craft.entries.section("nasiProjekti").one() %}
            <a href="{{ allProjects.url }}" class="btn btn-primary d-none">Vsi projekti</a>
        </div>

        <div class="gallery-grid">
            {% for project in projects %}
                {% set projectInfo = project.projectInfo.one() %}
                <a href="{{ project.url }}" class="gallery-item{{ loop.index == 1 ? ' is-wide' : '' }}{{ loop.index == 2 ? ' is-tall' : '' }}">
                    <img src="{{ projectInfo.galerijaSlik.one().getUrl({ width: 400, format: 'jpg' }) }}" alt="{{ projectInfo.nazivProjekta }}" loading="lazy">
                    <div class="item-info">
                        {% if project.kategorija.one() %}<span class="category">{{ project.kategorija.one().title }}</span>{% endif %}
                        <span class="title">{{ projectInfo.nazivProjekta }}</span>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
