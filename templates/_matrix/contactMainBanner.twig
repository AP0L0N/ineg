{#
    Glavni kontaktni modul — kontaktna stran v celoti (2026 redesign)
    Polja bloka (item): image, naslov, podnaslov, opis, customCssClasses
    Globalni set: contactInfo.contactInfo.* (nazivPodjetja, naslov, infoEmail, telefon, telefon2, googleMapsEmbed)

    Opomba: nekatere vsebine (delovni čas, polja obrazca, pogosta vprašanja) še nimajo
    ustreznih CMS polj, zato so v tej predlogi primeroma vpisane statično.
#}
{% for item in field.contactMainBanner.all() %}
<div class="contact-page {{ field.customCssClasses }}">

    {# ───────────────────── DROBTINICE ───────────────────── #}
    <div class="breadcrumb-bar">
        <div class="container">
            <ul class="breadcrumb-list">
                <li><a href="/">Domov</a></li>
                <li class="sep">/</li>
                <li class="current">Kontakt</li>
            </ul>
        </div>
    </div>

    {# ───────────────────── HERO ───────────────────── #}
    <section class="contact-hero">
        {% if item.image is defined and item.image.one() %}
            <div class="background-image">
                {% include "helpers/picture" with { desktop: { image: item.image.one(), width: 2000 } } %}
            </div>
        {% endif %}
        <div class="container">
            <div class="hero-content">
                <span class="eyebrow"><i class="fas fa-comments"></i> Kontaktirajte nas</span>
                <h1>{{ item.naslov }}</h1>
                {% if item.podnaslov %}<p class="lead">{{ item.podnaslov }}</p>{% endif %}

                <div class="hero-trust">
                    <div class="trust-item">
                        <span class="stars">★★★★★</span>
                        <span><strong>5,0</strong> Google ocena</span>
                    </div>
                    <span class="divider" aria-hidden="true"></span>
                    <div class="trust-item"><span><strong>10+</strong> let izkušenj</span></div>
                    <span class="divider" aria-hidden="true"></span>
                    <div class="trust-item"><span><strong>500+</strong> izdelanih teras</span></div>
                </div>
            </div>
        </div>

            
        {# ───────────────────── HITER STIK ───────────────────── #}
        <section class="quick-contact">
            <div class="container">
                <div class="quick-contact-card">
                    {% if contactInfo.contactInfo.telefon %}
                        <a href="tel:{{ contactInfo.contactInfo.telefon }}" class="quick-item">
                            <span class="icon"><i class="fas fa-phone-alt"></i></span>
                            <span class="text">
                                <span class="label">Pokličite nas</span>
                                <span class="value">{{ contactInfo.contactInfo.telefon }}</span>
                            </span>
                        </a>
                    {% endif %}
                    {% if contactInfo.contactInfo.infoEmail %}
                        <a href="mailto:{{ contactInfo.contactInfo.infoEmail }}" class="quick-item">
                            <span class="icon"><i class="fas fa-envelope"></i></span>
                            <span class="text">
                                <span class="label">Pišite nam</span>
                                <span class="value">{{ contactInfo.contactInfo.infoEmail }}</span>
                            </span>
                        </a>
                    {% endif %}
                    {% if contactInfo.contactInfo.naslov %}
                        <a href="https://maps.app.goo.gl/ynR4SBpQZDncNSRQ8" class="quick-item" target="_blank" rel="noopener">
                            <span class="icon"><i class="fas fa-map-marker-alt"></i></span>
                            <span class="text">
                                <span class="label">Obiščite nas</span>
                                <span class="value">{{ contactInfo.contactInfo.naslov }}</span>
                            </span>
                        </a>
                    {% endif %}
                    <div class="quick-item">
                        <span class="icon"><i class="fas fa-clock"></i></span>
                        <span class="text">
                            <span class="label">Delovni čas</span>
                            <span class="value">Pon–Pet: <br>8:00–16:00</span>
                        </span>
                    </div>
                </div>
            </div>
        </section>
    </section>

    {# ───────────────────── OBRAZEC + PODATKI O PODJETJU ───────────────────── #}
    <section class="contact-main">
        <div class="container">
            <div class="contact-layout">

                <div class="contact-form-card">
                    <span class="eyebrow">Povpraševanje</span>
                    <h2>Pripravimo vam <span>informativno ponudbo</span></h2>
                    <p>Izpolnite spodnji obrazec in odgovorili vam bomo v najkrajšem možnem času.</p>

                    <form id="contactForm" class="contact-form" onsubmit="return false;">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="contactName">Ime in priimek</label>
                                <input type="text" id="contactName" name="name" placeholder="Janez Novak" required>
                            </div>
                            <div class="form-group">
                                <label for="contactPhone">Telefon</label>
                                <input type="tel" id="contactPhone" name="phone" placeholder="+386 40 000 000" required>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="contactEmail">E-naslov</label>
                                <input type="email" id="contactEmail" name="email" placeholder="ime@primer.si" required>
                            </div>
                            <div class="form-group">
                                <label for="contactType">Vrsta povpraševanja</label>
                                <select id="contactType" name="type" required>
                                    <option value="" disabled selected>Izberite vrsto</option>
                                    <option>Lesena terasa</option>
                                    <option>Leseni fasadni sistemi</option>
                                    <option>Lesene ograje</option>
                                    <option>Vrtne hiške in nadstreški</option>
                                    <option>Drugo</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="contactMessage">Sporočilo</label>
                            <textarea id="contactMessage" name="message" rows="5" placeholder="Opišite želen produkt, velikost, material in način montaže." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">Pošlji povpraševanje</button>
                        <p class="form-note">Odgovorimo v enem delovnem dnevu.</p>
                        <div class="form-feedback" role="status" aria-live="polite" style="display: none;"></div>
                    </form>
                </div>

                <aside class="office-card">
                    {% if contactInfo.contactInfo.nazivPodjetja %}<h3>{{ contactInfo.contactInfo.nazivPodjetja }}</h3>{% endif %}
                    {% if item.opis %}<p class="office-description">{{ item.opis }}</p>{% endif %}
                    <ul class="office-details">
                        {% if contactInfo.contactInfo.naslov %}
                            <li><i class="fal fa-map-marker-alt"></i> <span>{{ contactInfo.contactInfo.naslov }}</span></li>
                        {% endif %}
                        {% if contactInfo.contactInfo.infoEmail %}
                            <li><i class="fal fa-envelope"></i> <a href="mailto:{{ contactInfo.contactInfo.infoEmail }}">{{ contactInfo.contactInfo.infoEmail }}</a></li>
                        {% endif %}
                        {% if contactInfo.contactInfo.telefon %}
                            <li><i class="fal fa-phone"></i> <a href="tel:{{ contactInfo.contactInfo.telefon }}">{{ contactInfo.contactInfo.telefon }}</a></li>
                        {% endif %}
                        {% if contactInfo.contactInfo.telefon2 %}
                            <li><i class="fal fa-phone"></i> <a href="tel:{{ contactInfo.contactInfo.telefon2 }}">{{ contactInfo.contactInfo.telefon2 }}</a></li>
                        {% endif %}
                    </ul>
                </aside>

            </div>
        </div>
    </section>

    {# ───────────────────── ZEMLJEVID ───────────────────── #}
    {% if contactInfo.contactInfo.googleMapsEmbed %}
        <section class="contact-map">
            <div class="container">
                <div class="map-frame">
                    {{ contactInfo.contactInfo.googleMapsEmbed | raw }}
                </div>
            </div>
        </section>
    {% endif %}

</div>
{% endfor %}

{# ───────────────────── STRUKTURIRANI PODATKI (SEO / AI) ───────────────────── #}
{% import "helpers/structured-data" as sd %}
{% set contactName = contactInfo.contactInfo.nazivPodjetja is defined and contactInfo.contactInfo.nazivPodjetja ? contactInfo.contactInfo.nazivPodjetja : 'INeG – Inštitut nizkoenergijske gradnje' %}
{% set contactPhone = contactInfo.contactInfo.telefon is defined and contactInfo.contactInfo.telefon ? contactInfo.contactInfo.telefon : '+38641661686' %}
{% set contactEmail = contactInfo.contactInfo.infoEmail is defined and contactInfo.contactInfo.infoEmail ? contactInfo.contactInfo.infoEmail : 'info@ineg.si' %}
{% set contactAddress = contactInfo.contactInfo.naslov is defined and contactInfo.contactInfo.naslov ? contactInfo.contactInfo.naslov : 'Ropretova cesta 18, 1234 Mengeš' %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ entry.url | json_encode | raw }}
    },
    "name": {{ (item.naslov is defined ? item.naslov : 'Kontakt') | json_encode | raw }},
    "description": {{ (item.podnaslov is defined ? item.podnaslov : 'Kontaktirajte INeG za brezplačen posvet in informativno ponudbo.') | json_encode | raw }},
    "url": {{ entry.url | json_encode | raw }},
    "mainEntity": {
        "@type": "HomeAndConstructionBusiness",
        "name": {{ contactName | json_encode | raw }},
        "telephone": {{ contactPhone | json_encode | raw }},
        "email": {{ contactEmail | json_encode | raw }},
        "url": "https://ineg.si",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Ropretova cesta 18",
            "addressLocality": "Mengeš",
            "postalCode": "1234",
            "addressCountry": "SI"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": "46.1655",
            "longitude": "14.5750"
        },
        "openingHoursSpecification": [
            {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
                "opens": "08:00",
                "closes": "16:00"
            }
        ]
    }
}
</script>

{{ sd.breadcrumb([
    { name: 'Domov', url: siteUrl },
    { name: 'Kontakt', url: entry.url }
]) }}

<script>
(function () {
    var form = document.getElementById('contactForm');
    if (!form) return;

    var feedback = form.querySelector('.form-feedback');
    var submitBtn = form.querySelector('button[type="submit"]');
    var originalBtnText = submitBtn ? submitBtn.textContent : '';

    function showFeedback(message, type) {
        if (!feedback) return;
        feedback.textContent = message;
        feedback.className = 'form-feedback form-feedback--' + type;
        feedback.style.display = 'block';
    }

    function hideFeedback() {
        if (!feedback) return;
        feedback.style.display = 'none';
        feedback.textContent = '';
    }

    function setLoading(isLoading) {
        if (!submitBtn) return;
        submitBtn.disabled = isLoading;
        submitBtn.textContent = isLoading ? 'Pošiljanje ...' : originalBtnText;
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        hideFeedback();

        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        setLoading(true);

        var formData = new FormData(form);
        var data = {};
        formData.forEach(function (value, key) {
            data[key] = value;
        });

        fetch('/actions/custom-module/user/contact', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(data)
        })
        .then(function (response) { return response.json(); })
        .then(function (result) {
            if (result.success) {
                showFeedback('Hvala za vaše povpraševanje! Odgovorili vam bomo v najkrajšem možnem času.', 'success');
                form.reset();
            } else {
                showFeedback('Prišlo je do napake pri pošiljanju. Poskusite znova.', 'error');
            }
        })
        .catch(function () {
            showFeedback('Prišlo je do napake pri pošiljanju. Poskusite znova.', 'error');
        })
        .finally(function () {
            setLoading(false);
        });
    });
})();
</script>

