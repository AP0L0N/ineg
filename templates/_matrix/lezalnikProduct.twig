{#
    Izdelek — leseni ležalnik
    Polja: heading, description (Redactor), images (assets), price, specs
#}
{% set product = field is defined ? field : null %}
{% set heading = product and product.heading ? product.heading : ('Leseni ležalnik' | t) %}
{% set description = product and product.description ? product.description : null %}
{% set images = product and product.images is defined ? product.images.all() : [] %}
{% set price = product and product.price ? product.price : null %}
{% set specs = product and product.specs ? product.specs : null %}

<section class="lezalnik-product">
    <div class="container">
        <div class="lezalnik-product__layout">
            <div class="lezalnik-product__gallery">
                {% if images|length %}
                    {% for image in images %}
                        <figure>
                            {% include "helpers/picture" with { desktop: { image: image, width: 900 } } %}
                        </figure>
                    {% endfor %}
                {% else %}
                    <figure>
                        <img src="/assets/images/lesene_terase/2.jpg" alt="{{ 'Vzorec eksotičnega lesa — terasa' | t }}" loading="lazy">
                    </figure>
                    <figure>
                        <img src="/assets/images/lesene_terase/5.jpg" alt="{{ 'Vzorec eksotičnega lesa — Garapa' | t }}" loading="lazy">
                    </figure>
                    <figure>
                        <img src="/assets/images/lesene_terase/6.jpg" alt="{{ 'Vzorec eksotičnega lesa — detajl' | t }}" loading="lazy">
                    </figure>
                {% endif %}
            </div>

            <div class="lezalnik-product__info">
                <span class="eyebrow">{{ 'Zunanji leseni dodatki' | t }}</span>
                <h1>{{ heading }}</h1>

                {% if description %}
                    <div class="lezalnik-product__description">
                        {{ description | raw }}
                    </div>
                {% else %}
                    <p>{{ 'Leseni ležalnik izdelamo iz enakih eksotičnih lesov, ki jih uporabljamo za terase — Cumaru, IPE, Garapa in druge. Tako dosežemo skladnost, dolgo obstojnost in prijeten občutek na otip.' | t }}</p>
                    <p>{{ 'Vsak kos je narejen po meri. Sporočite nam želene mere, vrsto lesa in morebitne dodatke — pripravimo vam ponudbo.' | t }}</p>
                {% endif %}

                {% if price %}
                    <p class="lezalnik-product__price">{{ price }}</p>
                {% endif %}

                {% if specs %}
                    <div class="lezalnik-product__specs">
                        <h2>{{ 'Specifikacije' | t }}</h2>
                        <p>{{ specs | nl2br }}</p>
                    </div>
                {% endif %}

                <div class="lezalnik-product__form-wrap">
                    <span class="eyebrow">{{ 'Naročilo' | t }}</span>
                    <h2>{{ 'Pošljite povpraševanje' | t }}</h2>
                    <p>{{ 'Obrazec odpre e-pošto na prodaja@ineg.si. Odgovorimo v enem delovnem dnevu.' | t }}</p>

                    <form id="lezalnikOrderForm" class="lezalnik-order-form" novalidate>
                        <div class="form-group">
                            <label for="lezalnikName">{{ "Ime in priimek" | t }}</label>
                            <input type="text" id="lezalnikName" name="name" required>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="lezalnikEmail">{{ "E-naslov" | t }}</label>
                                <input type="email" id="lezalnikEmail" name="email" required>
                            </div>
                            <div class="form-group">
                                <label for="lezalnikPhone">{{ "Telefon" | t }}</label>
                                <input type="tel" id="lezalnikPhone" name="phone">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="lezalnikMessage">{{ "Sporočilo" | t }}</label>
                            <textarea id="lezalnikMessage" name="message" rows="5" placeholder="{{ 'Mere, vrsta lesa, količina …' | t }}" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">{{ "Pošlji povpraševanje" | t }}</button>
                        <p class="form-note">{{ 'Ali pišite neposredno na' | t }} <a href="mailto:prodaja@ineg.si">prodaja@ineg.si</a></p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
