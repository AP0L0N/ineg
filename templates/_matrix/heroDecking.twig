{#
    Hero / naslovni slider modul — lesene terase
    Pričakovani podatki (data):
      data.eyebrow            (string)
      data.slides             (array)  -> { image, heading, headingHighlight, lead }
      data.primaryButton      ({ url, label })
      data.secondaryButton    ({ url, label })
      data.trust              (array)  -> { value, label, stars(bool) }
#}
{% set data = data is defined ? data : field %}
{% set slides = data.slides is defined ? data.slides : [] %}

<section class="hero-decking">
    <div class="swiper">
        <div class="swiper-wrapper">
            {% for slide in slides %}
                <div class="swiper-slide">
                    <div class="hero-slide" style="background-image: url({{ slide.image.one().getUrl({ width: 2500, format: 'jpg' }) }});">
                        <div class="container">
                            <div class="hero-content">
                                {% if data.eyebrow is defined %}
                                    <span class="eyebrow">{{ data.eyebrow }}</span>
                                {% endif %}
                                <h1>
                                    {{ slide.heading }}
                                    {% if slide.headingHighlight is defined %}<span>{{ slide.headingHighlight }}</span>{% endif %}
                                </h1>
                                {% if slide.lead is defined %}
                                    <p class="lead">{{ slide.lead }}</p>
                                {% endif %}

                                <div class="hero-actions">
                                    {% for button in slide.primaryButton %}
                                        {% if button['buttonText'] is not empty %}
                                            <a href="{{ button['buttonUrl'] }}" class="btn btn-primary">{{ button['buttonText'] }}</a>
                                        {% endif %}
                                    {% endfor %}

                                    {% for button in slide.secondaryButton %}
                                        {% if button['buttonText'] is not empty %}
                                            <a href="{{ button['buttonUrl'] }}" class="btn-ghost">{{ button['buttonText'] }}</a>
                                        {% endif %}
                                    {% endfor %}
                                </div>

                                {% if slide.includeTrust is defined and slide.includeTrust %}
                                    <div class="hero-trust">
                                        {% set trust = [
                                            { value: '500+', label: 'uspešnih projektov', stars: false },
                                            { value: '5,0', label: 'Google ocena', stars: true },
                                            { value: '0', label: 'odprtih reklamacij', stars: false }
                                        ] %}
                                        {% for item in trust %}
                                            <div class="trust-item">
                                                {% if item.stars is defined and item.stars %}
                                                    <span class="stars">★★★★★</span>
                                                {% endif %}
                                                <span><strong>{{ item.value }}</strong> {{ item.label }}</span>
                                            </div>
                                            {% if not loop.last %}<span class="divider" aria-hidden="true"></span>{% endif %}
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination {{ slides | length == 1 ? 'd-none' : '' }}"></div>
    </div>
</section>
