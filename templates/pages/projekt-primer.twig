{% extends '_layouts/site-content' %}

{#
    Projekti — seznam vseh referenc (section: nasiProjekti) z možnostjo filtriranja
    po kategoriji (GET parameter: kategorija).
#}

{% block content %}

    {% if entry is defined %}

        {% set kategorijaSlug = craft.app.request.getQueryParam('kategorija') ?: '' %}
        {% set activeCategory = kategorijaSlug ? craft.categories().group('kategorija').slug(kategorijaSlug).one() : null %}
        {% set categories = craft.categories().group('kategorija').all() %}

        {% set query = craft.entries().section('projekti').orderBy('postDate desc') %}
        {% if activeCategory %}
            {% set query = query.relatedTo(activeCategory) %}
        {% endif %}

        {% set filterParams = {} %}
        {% if kategorijaSlug %}{% set filterParams = filterParams | merge({ kategorija: kategorijaSlug }) %}{% endif %}

        {% paginate query.limit(12) as pageInfo, items %}

        {# Drobtinice #}
        <div class="breadcrumb-bar">
            <div class="container">
                <ul class="breadcrumb-list">
                    <li><a href="/">Domov</a></li>
                    <li class="sep">/</li>
                    <li class="current">Projekti</li>
                </ul>
            </div>
        </div>

        <section class="projects-page">
            <div class="container">

                <div class="projects-page-head">
                    <h1>Projekti</h1>
                    <p>Oglejte si izbor izvedenih lesenih teras in drugih projektov iz naše delavnice.</p>
                </div>

                <form action="{{ entry.url }}" method="get" class="project-filters">
                    <div class="filter-field">
                        <label for="projectFilterKategorija" class="sr-only">{{ 'Kategorija' | t }}</label>
                        <select name="kategorija" id="projectFilterKategorija" onchange="this.form.submit()">
                            <option value="">{{ 'Vse kategorije' | t }}</option>
                            {% for category in categories %}
                                <option value="{{ category.slug }}" {{ kategorijaSlug == category.slug ? 'selected' }}>{{ category.title }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <button type="submit" class="btn btn-default">{{ 'Filtriraj' | t }}</button>

                    {% if kategorijaSlug %}
                        <a href="{{ entry.url }}" class="filter-clear">{{ 'Počisti filter' | t }}</a>
                    {% endif %}
                </form>

                {% if items | length %}
                    <div class="project-grid">
                        {% for item in items %}
                            {% set itemImage = item.projectInfo.galerijaSlik.one() %}
                            {% set itemCategory = item.kategorija.one() %}
                            <a href="{{ item.url }}" class="project-card">
                                {% if itemImage %}
                                    <div class="project-card-image">
                                        <img src="{{ itemImage.getUrl('croppedFullModule') }}" alt="{{ item.title }}" loading="lazy">
                                    </div>
                                {% endif %}
                                <div class="project-card-body">
                                    {% if itemCategory %}
                                        <span class="project-card-category">{{ itemCategory.title }}</span>
                                    {% endif %}
                                    <h2 class="project-card-title">{{ item.title }}</h2>
                                    {% if item.projectInfo.naslov is not empty %}
                                        <span class="project-card-location"><i class="fal fa-map-marker-alt"></i> {{ item.projectInfo.naslov }}</span>
                                    {% endif %}
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="project-no-results">
                        <i class="fal fa-search" aria-hidden="true"></i>
                        <p>{{ 'Za izbrano kategorijo trenutno ni najdenih projektov.' | t }}</p>
                    </div>
                {% endif %}

                {# Pagination #}
                {% if pageInfo.totalPages > 1 %}
                    <div class="pagination">
                        <div class="py-5 my-4 text-center d-flex justify-content-center align-items-center">
                            {% if pageInfo.prevUrl %}<a href="{{ url(pageInfo.prevUrl, filterParams) }}" class="prev mx-3 mx-md-4"><span>{{ "Nazaj" | t }}</span></a>{% endif %}

                            {% for page, pageUrl in pageInfo.getPrevUrls(3) %}
                                <a class="page d-inline-block mx-3 mx-md-4" href="{{ url(pageUrl, filterParams) }}">{{ page }}</a>
                            {% endfor %}

                            <span class="page current d-inline-block mx-3 mx-md-4">{{ pageInfo.currentPage }}</span>

                            {% for page, pageUrl in pageInfo.getNextUrls(3) %}
                                <a class="page d-inline-block mx-3 mx-md-4" href="{{ url(pageUrl, filterParams) }}">{{ page }}</a>
                            {% endfor %}

                            {% if pageInfo.nextUrl %}<a href="{{ url(pageInfo.nextUrl, filterParams) }}" class="next mx-3 mx-md-4"><span>{{ "Naprej" | t }}</span></a>{% endif %}
                        </div>
                    </div>
                {% endif %}

            </div>
        </section>

    {% endif %}

{% endblock %}
