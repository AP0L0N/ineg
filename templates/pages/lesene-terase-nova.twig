        "provider": {
            "@type": "HomeAndConstructionBusiness",
            "name": "INeG – Inštitut nizkoenergijske gradnje",
            "url": "https://ineg.si",
            "telephone": "+38641661686",
            "email": "info@ineg.si",
            "address": {
                "@type": "PostalAddress",
                "streetAddress": "Ropretova cesta 18",
                "addressLocality": "Mengeš",
                "postalCode": "1234",
                "addressCountry": "SI"
            }
        },
        "areaServed": {
            "@type": "Country",
            "name": "Slovenija"
        },
        "offers": {
            "@type": "AggregateOffer",
            "priceCurrency": "EUR",
