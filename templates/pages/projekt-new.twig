{% extends '_layouts/site-content' %}

{#
    Podstran projekta / reference (section: projekti) — dejanski podatki vnosa.
#}

{% block content %}

    {% if entry is defined %}

        {% set projectsListEntry = craft.entries().section('nasiProjekti').one() %}
        {% set categories = entry.kategorija.all() %}
        {% set images = entry.projectInfo.galerijaSlik.all() %}
        {% set heroImage = images | first %}
        {% set galleryImages = images %}

        <div class="project-detail">

            {# Drobtinice #}
            <div class="breadcrumb-bar">
                <div class="container">
                    <ul class="breadcrumb-list">
                        <li><a href="/">Domov</a></li>
                        <li class="sep">/</li>
                        {% if projectsListEntry %}<li><a href="{{ projectsListEntry.url }}">Projekti</a></li>
                        <li class="sep">/</li>{% endif %}
                        <li class="current">{{ entry.title }}</li>
                    </ul>
                </div>
            </div>

            {# Hero #}
            <div class="project-hero"{% if heroImage %} style="background-image: url({{ heroImage.getUrl('full') }})"{% endif %}>
                <div class="container">
                    <div class="hero-inner">
                        {% if categories | length %}
                            <div class="category-list">
                                {% for category in categories %}
                                    <span class="category">{{ category.title }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <h1>{{ entry.title }}</h1>
                        {% if entry.projectInfo.naslov is not empty %}
                            <span class="location"><i class="fal fa-map-marker-alt"></i> {{ entry.projectInfo.naslov }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Vsebina + stranska vrstica #}
            <div class="project-body">
                <div class="container">
                    <div class="project-layout">

                        <div class="project-content">
                            {% if entry.projectInfo.kratekOpis is not empty %}
                                <p class="lead">{{ entry.projectInfo.kratekOpis }}</p>
                            {% endif %}

                            {{ entry.projectInfo.besedilo | raw }}
                        </div>

                        <aside class="project-sidebar">
                            <h3>Podatki o projektu</h3>
                            <ul class="spec-list">
                                {% if entry.projectInfo.naslov is not empty %}
                                    <li><span class="label">Lokacija</span> <span class="value">{{ entry.projectInfo.naslov }}</span></li>
                                {% endif %}
                                {% for row in entry.projectInfo.metaPodatki %}
                                    {% if row.metaTitle is not empty or row.metaValue is not empty %}
                                        <li><span class="label">{{ row.metaTitle }}</span> <span class="value">{{ row.metaValue }}</span></li>
                                    {% endif %}
                                {% endfor %}
                                {% if entry.projectInfo.cena is not empty %}
                                    <li><span class="label">Cena</span> <span class="value">{{ entry.projectInfo.cena }}</span></li>
                                {% endif %}
                                {% if entry.projectInfo.cenaNaM2 is not empty %}
                                    <li><span class="label">Cena na m²</span> <span class="value">{{ entry.projectInfo.cenaNaM2 }}</span></li>
                                {% endif %}
                            </ul>
                            <div class="sidebar-cta">
                                <p>Želite podobno teraso?</p>
                                <a href="/kontakt" class="btn btn-primary">Pridobite ponudbo</a>
                            </div>
                        </aside>
                    </div>
                </div>
            </div>

            {# Galerija #}
            {% if galleryImages | length %}
                <div class="project-gallery">
                    <div class="container">
                        <div class="gallery-grid pswp-gallery">
                            {% for image in galleryImages %}
                                <figure class="gallery-figure">
                                    <a href="{{ image.getUrl('full') }}" data-pswp-width="{{ image.getWidth('full') }}" data-pswp-height="{{ image.getHeight('full') }}" target="_blank" rel="noreferrer">
                                        <img src="{{ image.getUrl('size800') }}" alt="{{ entry.title }} – slika {{ loop.index }}" loading="lazy">
                                    </a>
                                </figure>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {# CTA #}
            {% include '_matrix/ctaBanner' with { data: {
                background: '/assets/images/lesene-terase-banner-2.jpg',
                eyebrow: 'Začnimo vaš projekt',
                heading: 'Imate v mislih',
                headingHighlight: 'podoben projekt?',
                description: 'Pošljite nam povpraševanje in pripravili vam bomo idejno zasnovo ter informativno ponudbo.',
                button: { url: '/kontakt', label: 'Kontaktirajte nas' },
                phone: { number: '+386 (0)40 567 518', label: 'Pokličite', href: 'tel:+38640567518' }
            } } %}

            {# ───────────────────── STRUKTURIRANI PODATKI (SEO / AI) ───────────────────── #}
            {% import "helpers/structured-data" as sd %}
            {% set projectImages = [] %}
            {% for img in images %}
                {% set projectImages = projectImages | merge([url(img.getUrl('full'))]) %}
            {% endfor %}
            {% if projectImages | length == 0 %}
                {% set projectImages = ['https://ineg.si/assets/images/terase_1.jpg'] %}
            {% endif %}
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "CreativeWork",
                "mainEntityOfPage": {
                    "@type": "WebPage",
                    "@id": {{ entry.url | json_encode | raw }}
                },
                "name": {{ entry.title | json_encode | raw }},
                "description": {{ (entry.projectInfo.kratekOpis is not empty ? entry.projectInfo.kratekOpis : entry.title) | json_encode | raw }},
                "about": {{ (entry.projectInfo.kratekOpis is not empty ? entry.projectInfo.kratekOpis : entry.title) | json_encode | raw }},
                "datePublished": {{ entry.postDate | date("c") | json_encode | raw }},
                "creator": {
                    "@type": "HomeAndConstructionBusiness",
                    "name": "INeG – Inštitut nizkoenergijske gradnje",
                    "url": "https://ineg.si",
                    "telephone": "+38641661686",
                    "address": {
                        "@type": "PostalAddress",
                        "streetAddress": "Ropretova cesta 18",
                        "addressLocality": "Mengeš",
                        "postalCode": "1234",
                        "addressCountry": "SI"
                    }
                },
                "locationCreated": {
                    "@type": "Place",
                    "name": {{ (entry.projectInfo.naslov is not empty ? entry.projectInfo.naslov : 'Slovenija') | json_encode | raw }}
                },
                "image": {{ projectImages | json_encode | raw }}
            }
            </script>

            {{ sd.breadcrumb([
                { name: 'Domov', url: siteUrl },
                { name: projectsListEntry ? projectsListEntry.title : 'Projekti', url: projectsListEntry ? projectsListEntry.url : '/nasi-projekti' },
                { name: entry.title, url: entry.url }
            ]) }}
        </div>

    {% endif %}

{% endblock %}
