{% extends '_layouts/site-content' %}

{% set seoTitle = "Leseni ležalnik po meri | Eksotični les | INeG" %}
{% set seoDescription = "Leseni ležalnik iz več vrst eksotičnega lesa. Izdelava po meri, usklajena z vašo teraso. Pošljite naročilo na info@ineg.si." %}
{% set lezalnikSection = craft.app.sections.getSectionByHandle('leseniLezalnik') %}
{% set lezalnikPage = entry is defined ? entry : (lezalnikSection ? craft.entries.section('leseniLezalnik').one() : null) %}
{% set lezalnikUrl = lezalnikPage ? lezalnikPage.url : url('leseni-lezalnik') %}
{% set productBlocks = lezalnikPage and lezalnikPage.buildingBlocks is defined ? lezalnikPage.buildingBlocks.type('lezalnikProduct').all() : [] %}
{% set otherBlocks = lezalnikPage and lezalnikPage.buildingBlocks is defined ? lezalnikPage.buildingBlocks.type('not lezalnikProduct').all() : [] %}

{% block content %}

    <div class="breadcrumb-bar">
        <div class="container">
            <ul class="breadcrumb-list">
                <li><a href="/">{{ 'Domov' | t }}</a></li>
                <li class="sep">/</li>
                <li class="current">{{ 'Leseni ležalnik' | t }}</li>
            </ul>
        </div>
    </div>

    {% if productBlocks|length %}
        {% for field in productBlocks %}
            {% include '_matrix/lezalnikProduct' %}
        {% endfor %}
    {% else %}
        {% include '_matrix/lezalnikProduct' %}
    {% endif %}

    {% for field in otherBlocks %}
        {% include '_matrix/' ~ field.type %}
    {% endfor %}

    {% import "helpers/structured-data" as sd %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": "Leseni ležalnik",
        "description": "Leseni ležalnik po meri iz več vrst eksotičnega lesa.",
        "brand": {
            "@type": "Brand",
            "name": "INeG"
        },
        "url": {{ lezalnikUrl | json_encode | raw }}
    }
    </script>

    {{ sd.breadcrumb([
        { name: 'Domov', url: siteUrl },
        { name: 'Leseni ležalnik', url: lezalnikUrl }
    ]) }}

    <script>
    (function () {
        var form = document.getElementById('lezalnikOrderForm');
        if (!form) return;

        var feedback = form.querySelector('.form-feedback');
        var submitBtn = form.querySelector('button[type="submit"]');
        var originalBtnText = submitBtn ? submitBtn.textContent : '';

        function showFeedback(message, type) {
            if (!feedback) return;
            feedback.textContent = message;
            feedback.className = 'form-feedback form-feedback--' + type;
            feedback.style.display = 'block';
        }

        function hideFeedback() {
            if (!feedback) return;
            feedback.style.display = 'none';
            feedback.textContent = '';
        }

        function setLoading(isLoading) {
            if (!submitBtn) return;
            submitBtn.disabled = isLoading;
            submitBtn.textContent = isLoading ? 'Pošiljanje ...' : originalBtnText;
        }

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            hideFeedback();

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            setLoading(true);

            var data = {
                name: document.getElementById('lezalnikName').value.trim(),
                phone: document.getElementById('lezalnikPhone').value.trim(),
                email: document.getElementById('lezalnikEmail').value.trim(),
                type: 'Leseni ležalnik',
                message: document.getElementById('lezalnikMessage').value.trim()
            };

            fetch('/actions/custom-module/user/contact', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(data)
            })
            .then(function (response) { return response.json(); })
            .then(function (result) {
                if (result.success) {
                    showFeedback('Hvala za vaše povpraševanje! Odgovorili vam bomo v najkrajšem možnem času.', 'success');
                    form.reset();
                } else {
                    showFeedback('Prišlo je do napake pri pošiljanju. Poskusite znova.', 'error');
                }
            })
            .catch(function () {
                showFeedback('Prišlo je do napake pri pošiljanju. Poskusite znova.', 'error');
            })
            .finally(function () {
                setLoading(false);
            });
        });
    })();
    </script>

{% endblock %}
