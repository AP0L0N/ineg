        "description": "Izdelava lesenih teras po meri iz eksotičnega lesa in sibirskega macesna. Lesene fasade, ograje in druge lesene gradnje.",
        "@id": "https://ineg.si",
        "url": "https://ineg.si",
        "telephone": {{ phone | json_encode | raw }},
        "email": {{ email | json_encode | raw }},
        "priceRange": "€€€",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Ropretova cesta 18",
            "addressLocality": "Mengeš",
            "postalCode": "1234",
            "addressCountry": "SI"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": "46.1655",
            "longitude": "14.5750"
        },
        "openingHoursSpecification": [
            {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
                "opens": "08:00",
                "closes": "16:00"
            }
        ],
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "5.0",
            "reviewCount": "30"
        },
        "areaServed": "Slovenija"
    }
    </script>
{% endmacro %}
