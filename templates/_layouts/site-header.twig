{% set allSites = craft.app.sites.allSites %}
{% set currentSite = craft.app.sites.currentSite %}
{% set lezalnikSection = craft.app.sections.getSectionByHandle('leseniLezalnik') %}
{% set lezalnikPage = lezalnikSection ? craft.entries.section('leseniLezalnik').one() : null %}
{% set lezalnikUrl = lezalnikPage ? lezalnikPage.url : url('leseni-lezalnik') %}

<header id="mainHeader" class="fixed-top">

    {# ───────────────────── Zgornja informacijska vrstica ───────────────────── #}
    <div class="top-bar">
        <div class="container">
            <div class="top-bar-inner">

                <ul class="contact-list">
                    {% include '_includes/contact-people' with { variant: 'topbar' } %}
                    <li>
                        <a href="mailto:info@ineg.si">
                            <i class="fal fa-envelope"></i>
                            <span>info@ineg.si</span>
                        </a>
                    </li>
                    <li class="top-bar-address">
                        <i class="fal fa-map-marker-alt"></i>
                        <span>Ropretova cesta 18, Mengeš</span>
                    </li>
                </ul>

                <div class="top-bar-right">
                    <ul class="social-list">
                        <li>
                            <a href="https://www.facebook.com/slamnatahisa/" target="_blank" rel="noopener" aria-label="Facebook">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                        </li>
                        <li>
                            <a href="https://www.instagram.com/ineg_slovenia/" target="_blank" rel="noopener" aria-label="Instagram">
                                <i class="fab fa-instagram"></i>
                            </a>
                        </li>
                    </ul>

                    {# Izbirnik jezika — samo, če je v Craftu več kot ena stran; EN demo je odstranjen #}
                    {% if allSites|length > 1 %}
                        <div class="lang-selector">
                            <button type="button" class="lang-toggle" aria-haspopup="true" aria-expanded="false">
                                <i class="fal fa-globe"></i>
                                <span class="current">{{ currentSite.language|split('-')|first|upper }}</span>
                                <i class="fal fa-angle-down caret" aria-hidden="true"></i>
                            </button>
                            <ul class="lang-menu">
                                {% for site in allSites %}
                                    <li>
                                        <a href="{{ site.baseUrl }}" class="{{ site.handle == currentSite.handle ? 'is-active' }}">
                                            {{ site.language|split('-')|first|upper }} — {{ site.name }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# ───────────────────── Glavna navigacija ───────────────────── #}
    <div class="header-wrapper">
        <nav class="navbar navbar-expand-lg">
            <div class="container">

                <a class="navbar-brand" href="{{ url('') }}">
                    {% include "helpers/picture" with {desktop: {image: '/assets/images/logo_2.png', width: 160} } %}
                </a>

                <div class="mobile-actions d-flex d-lg-none">
                    <button class="search-toggle" type="button" aria-label="{{ 'Iskanje' | t }}" aria-controls="searchOverlay" aria-expanded="false">
                        <i class="fal fa-search"></i>
                    </button>
                    <button class="navbar-toggler collapsed" type="button" data-toggle="collapse" data-target="#navbarsExample07"
                        aria-controls="navbarsExample07" aria-expanded="false" aria-label="{{ 'Meni' | t }}">
                        <span class="fal fa-bars"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="navbarsExample07">
                    <ul class="navbar-nav mr-auto">

                        {% set navItem = craft.entries.section('naslovnaStran').one() %}
                        {% if navItem %}
                            <li class="nav-item {{ entry is defined and entry.section.handle == navItem.section.handle ? 'active' }}">
                                <a class="nav-link" href="{{ navItem.url }}">{{ navItem.title }}</a>
                            </li>
                        {% endif %}

                        <li class="nav-item dropdown {{ entry is defined and (entry.id | number) in (storitve.storitveInOpisi.all() | map(s => s.povezanaStoritev.one().id | number)) ? 'active' }}">
                            <a class="nav-link dropdown-toggle" href="#" id="dropdown07"
                                data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ 'Storitve' | t }}</a>

                            <div class="dropdown-menu" aria-labelledby="dropdown07">
                                {% if storitve is defined %}
                                    {% set services = storitve.storitveInOpisi.all() %}
                                    {# "Lesene terase" je naša vodilna storitev, zato v mega meniju izstopa z veliko kartico #}
                                    {% set featuredService = services|filter(item => item.povezanaStoritev.one() is not null and item.povezanaStoritev.one().section.handle == 'leseneTerase')|first %}
                                    {% set otherServices = services|filter(item => item.povezanaStoritev.one() is not null and item.povezanaStoritev.one().section.handle != 'leseneTerase') %}

                                    <div class="mega-menu">
                                        {% if featuredService %}
                                            {% set featuredEntry = featuredService.povezanaStoritev.one() %}
                                            <a href="{{ featuredEntry.url }}" class="mega-menu-featured">
                                                {% set featuredImage = featuredService.prikazneSlike.one() %}
                                                {% if featuredImage %}
                                                    <div class="card-bg">
                                                        {% include "helpers/picture" with {desktop: {image: featuredImage, width: 700} } %}
                                                    </div>
                                                {% endif %}
                                                <div class="card-body">
                                                    <span class="badge-primary">{{ 'Naša vodilna storitev' | t }}</span>
                                                    <p class="title">{{ featuredEntry.title }}</p>
                                                    <p class="description">{{ featuredService.kratekOpis }}</p>
                                                    <span class="arrow">{{ 'Odkrijte več' | t }} <i class="fal fa-angle-right"></i></span>
                                                </div>
                                            </a>
                                        {% endif %}

                                        <div class="mega-menu-list">
                                            {% for item in otherServices %}
                                                {% set itemPov = item.povezanaStoritev.one() %}
                                                <div class="mega-menu-list-item">
                                                    {% set image = item.prikazneSlike.one() %}
                                                    {% if image %}
                                                        <div class="thumb">
                                                            {% include "helpers/picture" with {desktop: {image: image, width: 160} } %}
                                                        </div>
                                                    {% endif %}
                                                    <p class="title">{{ itemPov.title }}</p>
                                                    <a href="{{ itemPov.url }}"></a>
                                                </div>
                                            {% endfor %}
                                            <div class="mega-menu-list-item">
                                                <div class="thumb">
                                                    <img src="/assets/images/lesene_terase/5.jpg" alt="{{ 'Leseni ležalnik' | t }}" width="160">
                                                </div>
                                                <p class="title">{{ 'Leseni ležalnik' | t }}</p>
                                                <a href="{{ lezalnikUrl }}"></a>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </li>

                        {% set navItem = craft.entries.section('seznamObjav').one() %}
                        {% if navItem %}
                            <li class="nav-item {{ entry is defined and entry.section.handle == navItem.section.handle ? 'active' }}">
                                <a class="nav-link" href="{{ navItem.url }}">{{ "Objave" | t }}</a>
                            </li>
                        {% endif %}

                        {% set navItem = craft.entries.section('oInstitutu').one() %}
                        {% if navItem %}
                            <li class="nav-item {{ entry is defined and entry.section.handle == navItem.section.handle ? 'active' }}">
                                <a class="nav-link" href="{{ navItem.url }}">{{ "O nas" | t }}</a>
                            </li>
                        {% endif %}

                        <li class="nav-item {{ (entry is defined and entry.section.handle == 'leseniLezalnik') or craft.app.request.segments|first == 'leseni-lezalnik' ? 'active' }}">
                            <a class="nav-link" href="{{ lezalnikUrl }}">{{ 'Leseni ležalnik' | t }}</a>
                        </li>

                        <li class="nav-item d-flex align-items-center justify-content-center">
                            <button class="search-toggle d-none d-lg-inline-flex" type="button" aria-label="{{ 'Iskanje' | t }}" aria-controls="searchOverlay" aria-expanded="false">
                                <i class="fa fa-search"></i>
                            </button>
                        </li>
                    </ul>

                    <div class="header-actions">

                        {% set navItem = craft.entries.section('kontakt').one() %}
                        <div class="question-button">
                            <a href="{{ navItem ? navItem.url : '/kontakt' }}" class="btn btn-primary">
                                <span>{{ "Kontaktirajte nas" | t }}</span>
                            </a>
                        </div>
                    </div>

                    {% include '_includes/contact-people' with { variant: 'mobile' } %}
                </div>
            </div>
        </nav>
    </div>

    {# ───────────────────── STRUKTURIRANI PODATKI — NAVIGACIJA ───────────────────── #}
    {% import "helpers/structured-data" as sd %}
    {% set navHome = craft.entries().section('naslovnaStran').one() %}
    {% set navServices = craft.entries().section('leseneTerase').one() %}
    {% set navBlog = craft.entries().section('seznamObjav').one() %}
    {% set navAbout = craft.entries().section('oInstitutu').one() %}
    {% set navContact = craft.entries().section('kontakt').one() %}
    {{ sd.siteNavigation([
        { name: navHome ? navHome.title : 'Domov', url: navHome ? navHome.url : siteUrl },
        { name: 'Storitve', url: navServices ? navServices.url : '/lesene-terase' },
        { name: navBlog ? navBlog.title : 'Objave', url: navBlog ? navBlog.url : '/vse-objave' },
        { name: navAbout ? navAbout.title : 'O nas', url: navAbout ? navAbout.url : '/o-institutu' },
        { name: 'Leseni ležalnik', url: lezalnikUrl },
        { name: navContact ? navContact.title : 'Kontakt', url: navContact ? navContact.url : '/kontakt' }
    ]) }}

    {# ───────────────────── Iskalna plast ───────────────────── #}
    {% set blogsEntry = craft.entries.section('seznamObjav').one() %}
    <div class="search-overlay" id="searchOverlay" aria-hidden="true">
        <div class="container">
            <form action="{{ blogsEntry ? blogsEntry.url : '/vse-objave' }}" method="get" class="search-form" role="search">
                <i class="fal fa-search search-icon" aria-hidden="true"></i>
                <input type="search" name="q" class="search-input" placeholder="{{ 'Poiščite teraso, les, blog …' | t }}" aria-label="{{ 'Iskanje po vsebini' | t }}" autocomplete="off">
                <button type="submit" class="search-submit">{{ 'Išči' | t }}</button>
                <button type="button" class="search-close" aria-label="{{ 'Zapri iskanje' | t }}">
                    <i class="fal fa-times"></i>
                </button>
            </form>
        </div>
    </div>
</header>

